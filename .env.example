# --- Hermes Control configuration -------------------------------------------
# Copy to .env and edit. Every value below is optional; the defaults match a
# stock Hermes install on this machine.

# Port the LAN-facing proxy listens on (this is what you open from the phone).
PROXY_PORT=3000

# Interface the proxy binds. 0.0.0.0 = reachable from the phone on your LAN.
PROXY_HOST=0.0.0.0

# Where the Hermes backend lives. Keep it on loopback: Hermes forces OAuth on
# a non-loopback bind, and its Host/Origin guards check the bound address.
HERMES_HOST=127.0.0.1
HERMES_PORT=9119

# Dashboard session token used to authenticate against the Hermes backend.
#
# Leave EMPTY to auto-discover: the proxy scrapes the token that Hermes injects
# into its own SPA HTML (GET / on loopback). That works against a `hermes
# dashboard` or `hermes serve` you did not start yourself.
#
# Set it explicitly when start.sh launches Hermes for you — it is exported as
# HERMES_DASHBOARD_SESSION_TOKEN so the backend adopts this exact value.
HERMES_TOKEN=

# --- Optional: the address other devices should use --------------------------
# Only needed when something in front of the proxy owns the public address —
# `tailscale serve`, say. It's what the QR code and the install hint hand out.
# TAILSCALE=1 bash start.sh sets this for you.
# PUBLIC_URL=https://your-host.your-tailnet.ts.net

# --- Optional: HTTPS ---------------------------------------------------------
# Set BOTH to serve over TLS, which lights up the dormant PWA layer (installable
# app, service worker, offline reading, web push). Generate with mkcert:
#   mkcert -install
#   mkcert -cert-file certs/lan.pem -key-file certs/lan-key.pem <LAN-IP> localhost
# HTTPS_CERT=./certs/lan.pem
# HTTPS_KEY=./certs/lan-key.pem

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
